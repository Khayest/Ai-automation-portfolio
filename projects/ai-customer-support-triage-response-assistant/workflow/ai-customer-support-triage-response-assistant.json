    {
      "parameters": {
        "sendTo": "khayestaman@gmail.com",
        "subject": "=🚨 {{ $json.priority }} Priority Support Ticket - {{ $json.category }}",
        "message": "=<h2>🚨 {{ $json.priority }} Priority Support Ticket</h2>\n\n<p>A customer support ticket requires human review.</p>\n\n<h3>Customer Details</h3>\n<p>\n<strong>Name:</strong> {{ $json.customer_name }}<br>\n<strong>Email:</strong> {{ $json.customer_email }}\n</p>\n\n<h3>Ticket Details</h3>\n<p>\n<strong>Subject:</strong> {{ $json.subject }}<br>\n<strong>Category:</strong> {{ $json.category }}<br>\n<strong>Priority:</strong> {{ $json.priority }}<br>\n<strong>Sentiment:</strong> {{ $json.sentiment }}\n</p>\n\n<h3>Customer Message</h3>\n<p>{{ $json.message }}</p>\n\n<h3>AI Summary</h3>\n<p>{{ $json.summary }}</p>\n\n<h3>Recommended Action</h3>\n<p>{{ $json.recommended_action }}</p>\n\n<h3>AI Draft Response</h3>\n<p>{{ $json.draft_response }}</p>\n\n<hr>\n\n<p>\n<strong>Human Review Required:</strong><br>\nThe AI-generated analysis and response are suggestions only.\nVerify the ticket before taking any action or sending a response to the customer.\n</p>",
